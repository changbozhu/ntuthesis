\NewDocumentCommand{\fpulse}{m}{
	% m(#1) (str): variable
	\begin{cases}
		1, & #1 = \numvec{0}  \\
		0, & #1 \neq \numvec{0} 
	\end{cases}
}
\def\fdirac{\fpulse}
\NewDocumentCommand{\fsigmoid}{m}{
	% m(#1) (str): variable
	\frac{1}{1 + \exp(-#1)}
}
\NewDocumentCommand{\flogit}{m}{
	% g#1 (str): variable
	\ln \left( \frac{#1}{1 - #1} \right)
}
\NewDocumentCommand{\ftanh}{m}{
	% g#1 (str): variable
	\frac{ \exp(#1) - \exp(-#1) }{ \exp(#1) + \exp(-#1) }
}
\NewDocumentCommand{\frelu}{m}{
	% g#1 (str): variable
	 \max\left( 0, #1 \right)
}
\NewDocumentCommand{\fsign}{m}{
	% g#1 (str): variable
	\begin{cases}
		1, & #1 > 0 \\
		0, & #1 = 0 \\
	   -1, & #1 < 0 
	\end{cases}
}


