%  pdf cdf and some functions
% \gauss(var, mean, std)
\pgfmathdeclarefunction{sgaussianpdf}{3}{%
	% #1 variable_domain
	% #2 mean
	% #3 standard variance
	\pgfmathparse{1/(#3*sqrt(2*pi))*exp(-((#1-#2)^2)/(2*#3^2))}%
}
\pgfmathdeclarefunction{cdf}{3}{%
	\pgfmathparse{1/(1+exp(-0.07056*((#1-#2)/#3)^3 - 1.5976*(#1-#2)/#3))}%
}
\pgfmathdeclarefunction{fq}{3}{%
	\pgfmathparse{1/(sqrt(2*pi*#1))*exp(-(sqrt(#1)-#2/#3)^2/2)}%
}
\pgfmathdeclarefunction{fq0}{1}{%
	\pgfmathparse{1/(sqrt(2*pi*#1))*exp(-#1/2))}%
}




% ============================================================
% 一、用 \pgfmathdeclarefunction 定义密度计算函数
%     参数说明：x 为自变量，其余为分布参数
% ============================================================

% 正态密度：normalpdf(x, mu, sigma)
\pgfmathdeclarefunction{normalpdf}{3}{%
  \pgfmathparse{exp(-0.5*((#1-#2)/#3)^2)/(sqrt(2*pi)*#3)}%
}

% 指数密度：exppdf(x, lambda)
\pgfmathdeclarefunction{exppdf}{2}{%
  \pgfmathparse{(#1<0)?0:(#2*exp(-#2*#1))}%
}

% 伽马密度：gammapdf(x, alpha, beta)
\pgfmathdeclarefunction{gammapdf}{3}{%
  \pgfmathparse{(#1<=0)?0:((#3^#2)/Gamma(#2)*#1^(#2-1)*exp(-#3*#1))}%
}
% 注：pgfmath 无内置 Gamma 函数；下面给出简单替代或直接写具体值

% 贝塔密度（仅 alpha,beta 为整数时可用阶乘）：betapdf(x, a, b)
\pgfmathdeclarefunction{betapdf}{3}{%
  \pgfmathparse{(#1<=0||#1>=1)?0:((#1^(#2-1))*((1-#1)^(#3-1))/beta(#2,#3))}%
}

% 对数正态：lognormpdf(x, mu, sigma)
\pgfmathdeclarefunction{lognormpdf}{3}{%
  \pgfmathparse{(#1<=0)?0:(exp(-0.5*((ln(#1)-#2)/#3)^2)/(#1*#3*sqrt(2*pi)))}%
}

% 逆伽马：invgammapdf(x, alpha, beta)
\pgfmathdeclarefunction{invgammapdf}{3}{%
  \pgfmathparse{(#1<=0)?0:((#3^#2)/Gamma(#2)*#1^(-#2-1)*exp(-#3/#1))}%
}

% 逆高斯：invgausspdf(x, mu, lambda)
\pgfmathdeclarefunction{invgausspdf}{3}{%
  \pgfmathparse{(#1<=0)?0:(sqrt(#3/(2*pi*#1^3))*exp(-#3*(#1-#2)^2/(2*#2^2*#1)))}%
}

% 瑞利：rayleighpdf(x, sigma)
\pgfmathdeclarefunction{rayleighpdf}{2}{%
  \pgfmathparse{(#1<0)?0:(#1/#2^2*exp(-#1^2/(2*#2^2)))}%
}

% 帕累托：paretopdf(x, xm, alpha)
\pgfmathdeclarefunction{paretopdf}{3}{%
  \pgfmathparse{(#1<#2)?0:(#3*#2^#3/#1^(#3+1))}%
}

% 威布尔：weibullpdf(x, k, lambda)
\pgfmathdeclarefunction{weibullpdf}{3}{%
  \pgfmathparse{(#1<0)?0:((#2/#3)*(#1/#3)^(#2-1)*exp(-(#1/#3)^#2))}%
}

% 拉普拉斯：laplacepdf(x, mu, b)
\pgfmathdeclarefunction{laplacepdf}{3}{%
  \pgfmathparse{(1/(2*#3))*exp(-abs(#1-#2)/#3)}%
}

% 伯努利 pmf：bernoullipmf(x, p)，x 取 0/1
\pgfmathdeclarefunction{bernoullipmf}{2}{%
  \pgfmathparse{(#1==0)?(1-#2):((#1==1)?#2:0)}%
}

% 泊松 pmf：poissonpmf(x, lambda)，x 为非负整数
\pgfmathdeclarefunction{poissonpmf}{2}{%
  \pgfmathparse{exp(-#2)*#2^#1/factorial(#1)}%
}

% 几何 pmf：geometricpmf(x, p)，x=1,2,...
\pgfmathdeclarefunction{geometricpmf}{2}{%
  \pgfmathparse{(#1<1)?0:(#2*(1-#2)^(#1-1))}%
}

% 二项 pmf：binomialpmf(x, n, p)
\pgfmathdeclarefunction{binomialpmf}{3}{%
  \pgfmathparse{(#1<0||#1>#2)?0:(binom(#2,#1)*#3^#1*(1-#3)^(#2-#1))}%
}

% 负二项 pmf：negbinpmf(x, r, p)，r 为整数
\pgfmathdeclarefunction{negbinpmf}{3}{%
  \pgfmathparse{(#1<0)?0:(binom(#1+#2-1,#1)*#3^#2*(1-#3)^#1)}%
}

